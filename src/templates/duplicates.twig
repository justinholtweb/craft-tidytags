{% extends "_layouts/cp" %}

{% set title = "Duplicates"|t('tidytags') %}
{% set selectedSubnavItem = "duplicates" %}

{% macro renderItem(item) %}
    {% import "tidytags/_macros" as tt %}
    <div class="tidytags-item">
        <span class="tidytags-item-title">
            {% if item.cpEditUrl %}
                <a href="{{ item.cpEditUrl }}" target="_blank" rel="noopener" title="Open this {{ item.sourceType == 'tag' ? 'tag' : 'entry' }} in a new tab">
                    <strong>{{ item.title }}</strong>
                </a>
            {% else %}
                <strong>{{ item.title }}</strong>
            {% endif %}
            {% if item.differentiator %}
                <span class="tidytags-diff">({{ item.differentiator }})</span>
            {% endif %}
        </span>
        <span class="tidytags-item-meta">
            in <a href="{{ cpUrl(item.sourceCpPath) }}">{{ item.sourceName }}</a>
            {{ tt.badge(item.sourceType) }}
            <span class="tidytags-item-id">#{{ item.id }}</span>
        </span>
        {% if item.displayValues|length %}
            <ul class="tidytags-display">
                {% for handle, value in item.displayValues %}
                    <li><strong>{{ handle }}:</strong> {{ value }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <div class="tidytags-usages">
            <button type="button" class="btn small tidytags-show-usages" data-element-id="{{ item.id }}" aria-expanded="false">
                Show usages
            </button>
            <div class="tidytags-usages-list" hidden></div>
        </div>
    </div>
{% endmacro %}

{#
 # One cluster as a form. `action` is merge or swap. The keep/move controls
 # and the submit button only render when the user may submit.
 #}
{% macro clusterForm(cluster, action, redirect, canSubmit, confirmText, buttonLabel, note = null) %}
    {% import "_includes/forms" as forms %}
    <form method="post" action="" class="tidytags-cluster">
        {{ csrfInput() }}
        {{ actionInput('tidytags/tags/' ~ action) }}
        {{ redirectInput(redirect) }}
        <ul class="tidytags-cluster-items">
            {% for item in cluster %}
                <li class="tidytags-cluster-item">
                    {% if canSubmit %}
                        <div class="tidytags-cluster-controls">
                            {{ forms.radio({
                                id: 'tidytags-keep-' ~ action ~ '-' ~ item.id,
                                name: 'targetId',
                                value: item.id,
                                checked: loop.first,
                                label: 'Keep'|t('tidytags'),
                            }) }}
                            {{ forms.checkbox({
                                id: 'tidytags-move-' ~ action ~ '-' ~ item.id,
                                name: 'sourceIds[]',
                                value: item.id,
                                checked: not loop.first,
                                label: (action == 'merge' ? 'Merge' : 'Move')|t('tidytags'),
                            }) }}
                        </div>
                    {% endif %}
                    {{ _self.renderItem(item) }}
                </li>
            {% endfor %}
        </ul>
        {% if canSubmit %}
            <div class="tidytags-cluster-actions">
                <button type="submit" class="btn small{{ action == 'merge' ? ' submit' }}" data-confirm="{{ confirmText }}">
                    {{ buttonLabel }}
                </button>
                {% if note %}<span class="tidytags-note">{{ note }}</span>{% endif %}
            </div>
        {% endif %}
    </form>
{% endmacro %}

{% block content %}
{% import "_includes/forms" as forms %}
{% import "tidytags/_macros" as tt %}

{% set siteOptions = [{ label: 'Primary site'|t('tidytags'), value: '' }] %}
{% for site in sites %}
    {% set siteOptions = siteOptions|merge([{ label: site.name, value: site.id }]) %}
{% endfor %}

{% set filterParams = { scope: scope, threshold: threshold }|merge(selectedSiteId ? { siteId: selectedSiteId } : {}) %}
{% set redirect = 'tidytags/duplicates?' ~ filterParams|merge(pagination.page > 1 ? { page: pagination.page } : {})|url_encode %}

<div class="tidytags-duplicates">
    <form method="get" action="{{ cpUrl('tidytags/duplicates') }}" class="tidytags-toolbar">
        {{ hiddenInput('scope', scope) }}
        <div class="flex">
            <div class="flex">
                <label for="tidytags-site">Site:</label>
                {{ forms.select({
                    id: 'tidytags-site',
                    name: 'siteId',
                    options: siteOptions,
                    value: selectedSiteId,
                    inputAttributes: { data: { autosubmit: true } },
                }) }}
            </div>
            <div class="flex">
                <label for="tidytags-threshold">Similarity threshold:</label>
                {{ forms.text({
                    id: 'tidytags-threshold',
                    type: 'number',
                    name: 'threshold',
                    value: threshold,
                    min: 0,
                    max: maxThreshold,
                    size: 3,
                }) }}
            </div>
            <button type="submit" class="btn submit">Scan</button>
        </div>
        <p class="tidytags-note">
            Lower threshold = stricter matching. Default is 2 (catches typos and pluralization).
            The threshold only applies to the fuzzy match strategy.
            Configure differentiator and display fields per source in
            <a href="{{ cpUrl('settings/plugins/tidytags') }}">Settings → Tidy Tags</a>.
        </p>
    </form>

    <nav class="tidytags-tabs" aria-label="{{ 'Scope'|t('tidytags') }}">
        {% for key, label in { within: 'Within source', cross: 'Across sources' } %}
            <a href="{{ cpUrl('tidytags/duplicates', filterParams|merge({ scope: key })) }}"
               class="tidytags-tab{{ scope == key ? ' is-active' }}"
               {% if scope == key %}aria-current="page"{% endif %}>
                {{ label }}
            </a>
        {% endfor %}
    </nav>

    {% if scope == 'cross' %}
        <p class="tidytags-note">
            Items appearing under more than one source — usually a sign that an editor created a Tag for
            something already maintained as a Team or Competition. Use <strong>Swap</strong> to re-point
            relations from one entry to another (the source element is left in place for you to delete by
            hand once you've verified).
        </p>
    {% endif %}

    {% if pagination.total == 0 %}
        <p>
            {% if scope == 'cross' %}
                No cross-source duplicates found at threshold {{ threshold }}.
            {% else %}
                No within-source duplicate clusters found at threshold {{ threshold }}.
            {% endif %}
        </p>
    {% else %}
        <p class="tidytags-page-summary light">
            {{ 'Showing clusters {first}–{last} of {total}'|t('tidytags', {
                first: pagination.first|number,
                last: pagination.last|number,
                total: pagination.total|number,
            }) }}
        </p>

        {% set previousUid = null %}
        {% for entry in clusters %}
            {% set source = entry.source %}
            {% if source and source.uid != previousUid %}
                <h3 class="tidytags-cluster-heading">
                    <span>{{ source.name }}</span>
                    {{ tt.badge(source.type, source.typeLabel) }}
                </h3>
                {% set previousUid = source.uid %}
            {% endif %}

            {% if scope == 'cross' %}
                {{ _self.clusterForm(entry.items, 'swap', redirect, canManage,
                    'Swap selected items into the target? Relations will be re-pointed; the source items themselves are left in place.',
                    'Swap relations') }}
            {% elseif source.isWritable %}
                {{ _self.clusterForm(entry.items, 'merge', redirect, canManage and canDelete,
                    'Merge selected tags into the target? This cannot be undone.',
                    'Merge cluster') }}
            {% else %}
                {{ _self.clusterForm(entry.items, 'swap', redirect, canManage,
                    'Re-point relations from selected entries to the target? The entries themselves are left in place — delete them by hand once verified.',
                    'Swap relations',
                    "Read-only source — Tidy Tags can swap relations but won't delete entries.") }}
            {% endif %}
        {% endfor %}

        {{ tt.pager(pagination, 'tidytags/duplicates', filterParams) }}
    {% endif %}
</div>

{% js %}
(function(){
    var root = document.querySelector('.tidytags-duplicates');
    if (!root) return;

    root.querySelectorAll('[data-autosubmit]').forEach(function(input){
        input.addEventListener('change', function(){ input.form.submit(); });
    });

    root.addEventListener('click', function(e){
        var confirmBtn = e.target.closest('[data-confirm]');
        if (confirmBtn && !confirm(confirmBtn.getAttribute('data-confirm'))) {
            e.preventDefault();
        }
    });

    root.addEventListener('click', function(e){
        var btn = e.target.closest('.tidytags-show-usages');
        if (!btn) return;
        var list = btn.parentElement.querySelector('.tidytags-usages-list');
        if (!list) return;

        if (!list.hidden) {
            list.hidden = true;
            btn.textContent = 'Show usages';
            btn.setAttribute('aria-expanded', 'false');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Loading…';
        var data = new URLSearchParams();
        data.set('elementId', btn.getAttribute('data-element-id'));

        fetch(Craft.getActionUrl('tidytags/tags/usages') + '?' + data.toString(), {
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(r){ return r.json(); })
        .then(function(j){
            renderUsages(list, j);
            btn.textContent = 'Hide usages';
        })
        .catch(function(){
            renderMessage(list, 'Failed to load usages.');
            btn.textContent = 'Show usages';
        })
        .then(function(){
            btn.disabled = false;
            list.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
        });
    });

    function clear(node){
        while (node.firstChild) node.removeChild(node.firstChild);
    }

    function renderMessage(list, text){
        clear(list);
        var em = document.createElement('em');
        em.className = 'tidytags-note';
        em.textContent = text;
        list.appendChild(em);
    }

    function renderUsages(list, j){
        if (!j || !j.success) { renderMessage(list, 'Failed to load usages.'); return; }
        if (!j.usages || !j.usages.length) {
            renderMessage(list, "No relations — this element isn't in use.");
            return;
        }
        clear(list);
        var ul = document.createElement('ul');
        j.usages.forEach(function(u){
            var li = document.createElement('li');

            var label = document.createElement(u.cpEditUrl ? 'a' : 'span');
            if (u.cpEditUrl) {
                label.href = u.cpEditUrl;
                label.target = '_blank';
                label.rel = 'noopener';
            }
            label.textContent = u.title || '(untitled)';
            li.appendChild(label);

            var meta = document.createElement('span');
            meta.className = 'tidytags-usage-meta';
            var code = document.createElement('code');
            code.textContent = u.fieldHandle || '?';
            meta.appendChild(document.createTextNode(' in field '));
            meta.appendChild(code);
            if (u.siteName) {
                meta.appendChild(document.createTextNode(' · ' + u.siteName));
            }
            meta.appendChild(document.createTextNode(' · ' + (u.elementType || 'element')));

            li.appendChild(meta);
            ul.appendChild(li);
        });
        list.appendChild(ul);

        if (j.hasMore) {
            var more = document.createElement('p');
            more.className = 'tidytags-note';
            more.textContent = 'Showing the first ' + j.usages.length + ' usages.';
            list.appendChild(more);
        }
    }
})();
{% endjs %}
{% endblock %}
