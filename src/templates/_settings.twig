{% import "_includes/forms" as forms %}
{% import "tidytags/_macros" as tt %}

{% set channelOptions = [] %}
{% for section in sections %}
    {% if section.type == 'channel' %}
        {% set channelOptions = channelOptions|merge([{
            label: section.name ~ ' (' ~ section.handle ~ ')',
            value: section.uid,
        }]) %}
    {% endif %}
{% endfor %}

<h2>{{ "Matching"|t('tidytags') }}</h2>

<p>
    How Tidy Tags decides that two titles name the same thing. The right choice depends on
    your vocabulary, so there is no compromise default — pick the one that describes your
    titles.
</p>

{{ forms.selectField({
    label: 'Match strategy'|t('tidytags'),
    id: 'matchStrategy',
    name: 'matchStrategy',
    value: settings.matchStrategy,
    options: [
        { label: 'Fuzzy — tolerate typos (default)'|t('tidytags'), value: 'fuzzy' },
        { label: 'Strict — affixes and qualifiers, no typo tolerance'|t('tidytags'), value: 'strict' },
    ],
    instructions: 'Fuzzy suits free-text tags typed by editors, where duplicates are misspellings. Strict suits controlled vocabularies of proper nouns — clubs, competitions, places, people — where names sit close together in edit space.'|t('tidytags'),
}) }}

<div class="tidytags-callout">
    <p><strong>Fuzzy</strong> flags <code>Manchestor</code> against
        <code>Manchester</code> — and also <code>Durham</code> against <code>Fulham</code>,
        which are two characters apart.</p>
    <p><strong>Strict</strong> flags <code>FC Bayern Munich</code> against
        <code>Bayern Munich</code> and <code>Wrexham</code> against <code>Wrexham AFC</code>,
        but never reports <code>Arsenal</code> as a duplicate of <code>Arsenal Women</code>.</p>
</div>

{% if settings.matchStrategy == 'strict' %}
    {{ forms.textareaField({
        label: 'Affix tokens'|t('tidytags'),
        instructions: 'Words removed from the start and end of a title before comparing — one per line, or comma separated. Only the start and end: an affix in the middle is left alone, so "FIFA Club World Cup" is not reduced to "FIFA World Cup".'|t('tidytags'),
        id: 'affixTokens',
        name: 'affixTokens',
        value: settings.getAffixTokens|join("\n"),
        rows: 4,
        class: 'code',
    }) }}

    {{ forms.textareaField({
        label: 'Qualifier tokens'|t('tidytags'),
        instructions: 'Words that make two otherwise-matching titles different things — one per line, or comma separated. When one title has one of these and the other does not, the pair is rejected. This is the accuracy-critical list in strict mode and it is specific to your domain, so curate it against your own titles.'|t('tidytags'),
        id: 'qualifierTokens',
        name: 'qualifierTokens',
        value: settings.getQualifierTokens|join("\n"),
        rows: 6,
        class: 'code',
    }) }}
{% else %}
    <p class="tidytags-note">
        Affix and qualifier tokens only apply to the strict strategy. Switch to strict and save
        to configure them.
    </p>
{% endif %}

<hr>

<h2>{{ "Tag-like sections"|t('tidytags') }}</h2>

<p>
    Designate channel sections that should be treated as tag-like sources — typically the
    output of <code>php craft entrify/tags</code>. Entry-backed sources are read-only by
    default: Tidy Tags will show counts, per-site titles, and duplicate clusters, but rename,
    merge, and delete remain tag-only to avoid clobbering entry URLs, bodies, drafts, or
    revisions. Cross-source <em>swap</em> (re-pointing relations from one element to another
    without deleting the source) is supported and works across types.
</p>

{% if channelOptions|length == 0 %}
    <p class="tidytags-note">No channel sections exist yet.</p>
{% else %}
    {{ forms.checkboxSelectField({
        label: 'Tag-like sections'|t('tidytags'),
        instructions: 'Pick the channel sections you want Tidy Tags to surface alongside native tag groups.'|t('tidytags'),
        id: 'tagLikeSectionUids',
        name: 'tagLikeSectionUids',
        options: channelOptions,
        values: settings.tagLikeSectionUids,
        showAllOption: false,
    }) }}
{% endif %}

<hr>

<h2>{{ "Per-source field configuration"|t('tidytags') }}</h2>

<p>
    For each source you can pick:
</p>
<ul class="tidytags-bullets">
    <li><strong>Differentiator field</strong> — a field that distinguishes same-named items
        (e.g. a <code>sport</code> field that tells <em>England (Football)</em> apart from
        <em>England (Cricket)</em>). When set, two items with the same title but different
        differentiator values are <em>not</em> flagged as duplicates.</li>
    <li><strong>Display fields</strong> — fields whose values appear next to each item in
        duplicate clusters and the editor "did you mean" warning, so reviewers can tell
        similar items apart at a glance.</li>
</ul>

{% if sources|length == 0 %}
    <p class="tidytags-note">No sources to configure yet.</p>
{% else %}
    <table class="data fullwidth tidytags-field-config">
        <thead>
            <tr>
                <th scope="col">Source</th>
                <th scope="col">Differentiator field</th>
                <th scope="col">Display fields</th>
            </tr>
        </thead>
        <tbody>
            {% for source in sources %}
                {% set fields = fieldsBySourceUid[source.uid] ?? [] %}
                {% set differentiator = settings.getDifferentiatorHandle(source.uid) %}
                {% set display = settings.getDisplayHandles(source.uid) %}
                <tr>
                    <th scope="row">
                        <strong>{{ source.name }}</strong>
                        {{ tt.badge(source.type, source.typeLabel) }}
                        <br>
                        <code class="tidytags-handle">{{ source.handle }}</code>
                    </th>
                    {% set fieldOptions = fields|map(f => { label: f.name ~ ' (' ~ f.handle ~ ')', value: f.handle }) %}
                    <td>
                        {% if fields|length == 0 %}
                            <span class="tidytags-note">No custom fields available.</span>
                        {% else %}
                            {{ forms.select({
                                name: 'sourceFieldConfig[' ~ source.uid ~ '][differentiator]',
                                options: [{ label: '— None —'|t('tidytags'), value: '' }]|merge(fieldOptions),
                                value: differentiator,
                                inputAttributes: { aria: { label: 'Differentiator field for {name}'|t('tidytags', { name: source.name }) } },
                            }) }}
                        {% endif %}
                    </td>
                    <td>
                        {% if fields|length == 0 %}
                            <span class="tidytags-missing">—</span>
                        {% else %}
                            <div class="tidytags-display-fields">
                                {{ forms.checkboxGroup({
                                    name: 'sourceFieldConfig[' ~ source.uid ~ '][display]',
                                    options: fields|map(f => { label: f.name, value: f.handle }),
                                    values: display,
                                }) }}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

<p class="tidytags-note">
    These values can also be driven from <code>config/tidytags.php</code>, which overlays saved
    settings at request time — useful for per-environment configuration. Source field config
    keys by source UID, e.g.
    <code>'sourceFieldConfig' =&gt; ['af2a1ee1-...' =&gt; ['differentiator' =&gt; 'sport', 'display' =&gt; ['sport']]]</code>.
</p>
