{% extends "_layouts/cp" %}

{% set title = "Tidy Tags"|t('tidytags') %}
{% set selectedSubnavItem = "dashboard" %}

{% block content %}
{% import "tidytags/_macros" as tt %}
<div class="tidytags-dashboard">
    {% if rows|length == 0 %}
        <p>
            No sources found. Create a tag group in <a href="{{ cpUrl('settings/tags') }}">Settings → Tags</a>,
            or designate a channel section as tag-like in
            <a href="{{ cpUrl('settings/plugins/tidytags') }}">Settings → Tidy Tags</a>
            (useful if you've run <code>php craft entrify/tags</code>).
        </p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">Source</th>
                    <th scope="col">Total</th>
                    {% for site in sites %}
                        <th scope="col">{{ site.name }}</th>
                    {% endfor %}
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    {% set source = row.source %}
                    <tr>
                        <th scope="row">
                            <strong>{{ source.name }}</strong>
                            {{ tt.badge(source.type, source.typeLabel) }}
                            {% if not source.isWritable %}
                                <span class="tidytags-note" title="Read-only: rename, merge, and delete are disabled for entry-backed sources.">read-only</span>
                            {% endif %}
                            <br>
                            <code class="tidytags-handle">{{ source.handle }}</code>
                        </th>
                        <td>{{ row.total|number }}</td>
                        {% for site in sites %}
                            <td><span class="tidytags-count">{{ (row.countsBySite[site.id] ?? 0)|number }}</span></td>
                        {% endfor %}
                        <td>
                            <a class="btn small" href="{{ cpUrl(source.cpPath) }}">Manage</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}
