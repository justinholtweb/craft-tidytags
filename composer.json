{
    "name": "justinholtweb/craft-tidytags",
    "description": "Keeps your Craft CMS taxonomy clean: duplicate detection, merge, rename and pruning for tag-like entry sections, across every site.",
    "version": "6.0.0-beta.1",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "tags",
        "taxonomy",
        "duplicates",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://github.com/justinholtweb"
        }
    ],
    "support": {
        "issues": "https://github.com/justinholtweb/craft-tidytags/issues",
        "source": "https://github.com/justinholtweb/craft-tidytags",
        "docs": "https://github.com/justinholtweb/craft-tidytags/blob/6.0.0/README.md"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\TidyTags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\TidyTags\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Tidy Tags",
        "handle": "tidytags",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.dev",
        "description": "Keeps your Craft CMS taxonomy clean: duplicate detection, merge, rename and pruning for tag-like entry sections.",
        "documentationUrl": "https://github.com/justinholtweb/craft-tidytags/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-tidytags/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\TidyTags\\Plugin"
    }
}
